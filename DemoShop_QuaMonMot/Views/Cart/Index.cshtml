@model IEnumerable<DemoShop_QuaMonMot.Models.CartItem>
@{
    ViewData["Title"] = T["CartTitle"];
    var subtotal = Model.Sum(s => s.ThanhTien);
    var shippingFee = ViewBag.ShippingFee as double? ?? (subtotal > 0 ? 10.0 : 0.0);
    var couponDiscount = ViewBag.CouponDiscount as double? ?? 0.0;
    var orderTotal = ViewBag.OrderTotal as double? ?? Math.Max(0, subtotal - couponDiscount + shippingFee);
    var couponCode = ViewBag.CouponCode as string;
    var couponName = ViewBag.CouponName as string;
}
<!-- Bắt đầu giỏ hàng -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-8 table-responsive mb-5">
            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>@T["Product"]</th>
                        <th>@T["Price"]</th>
                        <th>@T["Quantity"]</th>
                        <th>@T["LineTotal"]</th>
                        <th>@T["Delete"]</th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td class="align-middle"><img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.tenHH" style="width: 50px;"><a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.MaHh">@item.tenHH</a></td>
                            <td class="align-middle">$@item.DonGia.ToString("#,##0.00")</td>
                            <td class="align-middle">
                                <div class="input-group quantity mx-auto" style="width: 100px;">
                                    <div class="input-group-btn">
                                        @* Nút TRỪ: truyền amount = -1 *@
                                        <a asp-action="UpdateQuantity" asp-controller="Cart"
                                           asp-route-id="@item.MaHh" asp-route-amount="-1"
                                           class="btn btn-sm btn-primary">
                                            <i class="fa fa-minus"></i>
                                        </a>
                                    </div>

                                    <input type="text" class="form-control form-control-sm bg-secondary border-0 text-center" value="@item.Soluong" readonly>

                                    <div class="input-group-btn">
                                        @* Nút CỘNG: truyền amount = 1 *@
                                        <a asp-action="UpdateQuantity" asp-controller="Cart"
                                           asp-route-id="@item.MaHh" asp-route-amount="1"
                                           class="btn btn-sm btn-primary">
                                            <i class="fa fa-plus"></i>
                                        </a>
                                    </div>
                                </div>
                            </td>
                            <td class="align-middle">$@item.ThanhTien.ToString("#,##0.00")</td>
                            <td class="align-middle">
                                <a asp-action="RemoveCart" asp-controller="Cart" asp-route-id="@item.MaHh">
                                    <button class="btn btn-sm btn-danger">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-lg-4">
            <form class="mb-3" asp-action="ApplyCoupon" asp-controller="Cart" method="post">
                <div class="input-group">
                    <input type="text" name="couponCode" class="form-control border-0 p-4" value="@couponCode" placeholder="@T["EnterCoupon"]">
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-primary">@T["Apply"]</button>
                    </div>
                </div>
            </form>

            @if (TempData["CouponMessage"] != null)
            {
                <div class="alert alert-success py-2">@TempData["CouponMessage"]</div>
            }

            @if (TempData["CouponError"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["CouponError"]</div>
            }

            @if (!string.IsNullOrEmpty(couponCode))
            {
                <form asp-action="RemoveCoupon" asp-controller="Cart" method="post" class="mb-30">
                    <div class="d-flex align-items-center justify-content-between bg-light p-3">
                        <div>
                            <strong>@couponCode</strong>
                            <div class="small text-muted">@couponName</div>
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline-danger">@T["RemoveCoupon"]</button>
                    </div>
                </form>
            }

            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">@T["CartSummary"]</span></h5>
            <div class="bg-light p-30 mb-5">
                <div class="border-bottom pb-2">
                    <div class="d-flex justify-content-between mb-3">
                        <h6>@T["Subtotal"]</h6>
                        <h6>$@subtotal.ToString("#,##0.00")</h6>
                    </div>
                    @if (couponDiscount > 0)
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <h6 class="font-weight-medium">@T["Discount"]</h6>
                            <h6 class="font-weight-medium text-success">-$@couponDiscount.ToString("#,##0.00")</h6>
                        </div>
                    }
                    <div class="d-flex justify-content-between">
                        <h6 class="font-weight-medium">@T["ShippingFee"]</h6>
                        <h6 class="font-weight-medium">$@shippingFee.ToString("#,##0.00")</h6>
                    </div>
                </div>
                <div class="pt-2">
                    <div class="d-flex justify-content-between mt-2">
                        <h5>@T["Total"]</h5>
                        <h5>$@orderTotal.ToString("#,##0.00")</h5>
                    </div>
                    <a asp-action="ThanhToan"
                       asp-controller="Cart"
                       class="btn btn-block btn-primary font-weight-bold my-3 py-3">
                        @T["Checkout"]
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
<!-- Kết thúc giỏ hàng -->
