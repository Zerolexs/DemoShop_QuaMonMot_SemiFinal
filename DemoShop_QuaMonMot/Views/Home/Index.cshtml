@using Microsoft.AspNetCore.Http
@model IEnumerable<DemoShop_QuaMonMot.Models.HangHoa>
@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPage = ViewBag.TotalPage ?? 1;
    ViewData["Title"] = T["ShopTitle"];

}

@section Sidebar {
    <partial name="_P_Sidebar" />
}

<div id="product-list" class="row pb-3">
    @* --- THANH CÔNG CỤ --- *@
    <div class="col-12 pb-1">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                @* Nút Grid *@
                <button class="btn btn-sm btn-light" onclick="changeView('grid')"><i class="fa fa-th-large"></i></button>
                @* Nút List *@
                <button class="btn btn-sm btn-light ml-2" onclick="changeView('list')"><i class="fa fa-bars"></i></button>
            </div>
            <div class="ml-2">
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-toggle="dropdown">@T["Sort"]</button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="@Url.Action("Index", new { sort = "latest", loai = ViewBag.MaLoai, min = ViewBag.MinPrice, max = ViewBag.MaxPrice })">@T["Latest"]</a>
                        <a class="dropdown-item" href="@Url.Action("Index", new { sort = "price_asc", loai = ViewBag.MaLoai, min = ViewBag.MinPrice, max = ViewBag.MaxPrice })">@T["PriceAsc"]</a>
                        <a class="dropdown-item" href="@Url.Action("Index", new { sort = "price_desc", loai = ViewBag.MaLoai, min = ViewBag.MinPrice, max = ViewBag.MaxPrice })">@T["PriceDesc"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- NÚT ADMIN --- *@
    @if (Context.Session.GetInt32("VaiTro") == 1)
    {
        <div class="col-12 mb-4">
            <a asp-controller="Admin" asp-action="Create" class="btn btn-primary font-weight-bold py-2 px-4">
                <i class="fa fa-plus mr-2"></i> @T["AddNewProduct"]
            </a>
        </div>
    }

    @* --- DANH SÁCH SẢN PHẨM --- *@
    @foreach (var item in Model)
    {
        
        var favIds = ViewBag.FavoriteIds as List<int> ?? new List<int>();
        bool isLiked = favIds.Contains(item.MaHh);
        

        <div class="col-lg-4 col-md-6 col-sm-6 pb-1">
            <div class="product-item bg-light mb-4">
                <div class="product-img position-relative overflow-hidden">
                    @* SỬA: Thêm onerror để xử lý ảnh lỗi *@
                    <img class="img-fluid w-100" src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh"
                         onerror="this.src='/Hinh/HangHoa/default.jpg';">

                    <div class="product-action">
                        <a class="btn btn-outline-dark btn-square" asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.MaHh">
                            <i class="fa fa-shopping-cart"></i>
                        </a>
                        <a class="btn btn-outline-dark btn-square btn-add-wishlist"
                           asp-controller="YeuThich"
                           asp-action="Add"
                           asp-route-id="@item.MaHh">
                            <i class="@(isLiked ? "fas text-danger" : "far") fa-heart"></i>
                        </a>
                        <a class="btn btn-outline-dark btn-square" href="#"><i class="fa fa-sync-alt"></i></a>
                        <a class="btn btn-outline-dark btn-square" asp-controller="Home" asp-action="Detail" asp-route-id="@item.MaHh">
                            <i class="fa fa-search"></i>
                        </a>
                    </div>
                </div>
                <div class="text-center py-4 px-2">
                    <a class="h6 text-decoration-none text-truncate d-block" asp-controller="Home" asp-action="Detail" asp-route-id="@item.MaHh">@item.TenHh</a>
                    <div class="d-flex align-items-center justify-content-center mt-2">
                        @* Dùng ?? 0 để tránh lỗi nếu DonGia bị Null, sau đó mới ToString *@
                        <h5>$@((item.DonGia ?? 0).ToString("F2"))</h5>

                        <h6 class="text-muted ml-2">
                            @* Tính giá khuyến mãi và làm tròn 2 chữ số *@
                            <del>$@(((item.DonGia ?? 0) * 1.1).ToString("F2"))</del>
                        </h6>
                    </div>

                    <div class="d-flex align-items-center justify-content-center mb-1">
                        <small class="fa fa-eye text-primary mr-2"></small>
                        <small>@item.SoLanXem @T["Views"]</small>
                    </div>

                    @if (Context.Session.GetInt32("VaiTro") == 1)
                    {
                        <div class="d-flex align-items-center justify-content-center mt-3 pt-2 border-top">
                            <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-sm btn-warning mr-2">
                                <i class="fa fa-edit"></i> @T["Edit"]
                            </a>
                            <form asp-controller="Admin" asp-action="DeleteHangHoa" asp-route-id="@item.MaHh"
                                  method="post" onsubmit="return confirm('@T["ConfirmDeleteProduct"]');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fa fa-trash"></i> @T["Delete"]
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* --- PHÂN TRANG --- *@
    <div class="col-12">
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@Context.Request.Query["search"]">@T["Previous"]</a>
                </li>
                @for (int i = 1; i <= totalPage; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" asp-controller="Home" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Context.Request.Query["search"]">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@Context.Request.Query["search"]">@T["Next"]</a>
                </li>
            </ul>
        </nav>
    </div>
</div>
<script>
    function changeView(mode) {
        const list = document.getElementById('product-list');
        const items = document.querySelectorAll('.item-container');

        if (mode === 'list') {
            list.classList.remove('row'); // Tùy template, thường là đổi sang dọc
            items.forEach(item => {
                item.className = 'col-12 mb-3'; // Chiếm toàn bộ chiều ngang
                // Bạn có thể thêm code để đổi style hiển thị nằm ngang ở đây
            });
        } else {
            list.classList.add('row');
            items.forEach(item => {
                item.className = 'col-lg-4 col-md-6 col-sm-6'; // Quay lại 3 cột
            });
        }
    }
</script>
@section Scripts {
    <script>
        $(document).ready(function () {
            $(".btn-add-wishlist").click(function (e) {
                e.preventDefault();

                var btn = $(this);
                var url = btn.attr("href");
                var icon = btn.find("i");

                $.post(url, function (res) {
                    if (res.success) {
                        // Sửa selector này cho chính xác với Layout của bạn
                        // Thường là thẻ span kế bên icon heart trong Header
                        var badges = $("[id='wishlist-count-badge']");
                            // Lấy số hiện tại từ cái đầu tiên tìm thấy
                        var currentCount = parseInt($(badges[0]).text()) || 0;

                        if (res.action === "added") {
                            icon.removeClass("far").addClass("fas text-danger");
                            badges.text(currentCount + 1); // Cập nhật tất cả các badge
                            alert("@T["AddedToWishlist"]");
                        } else {
                            icon.removeClass("fas text-danger").addClass("far");
                            badges.text(Math.max(0, currentCount - 1));
                            alert("@T["RemovedFromWishlist"]");
                        }
                    } else {
                        alert(res.message);
                        window.location.href = "/KhachHang/DangNhap";
                    }
                }).fail(function() {
                    alert("@T["ServerConnectionError"]");
                });
            });
        });
    </script>
}
