<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8">
    <title>QuaMonMot - @T["Shop"]</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content='QuaMonMot, @T["Shop"], @T["Product"]' name="keywords">
    <meta content='@T["StudyDisclaimer"]' name="description">

    <link href="~/img/favicon.ico" rel="icon">

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">

    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <link href="~/css/style.min.css" rel="stylesheet">
</head>

<body>
    <partial name="_P_Header" />

    <partial name="_P_Breadcrumb" />

    <div class="container-fluid">
        <div class="row px-xl-5">
            @* KIỂM TRA TRANG CON CÓ ĐỊNH NGHĨA SIDEBAR HAY KHÔNG *@
            @if (IsSectionDefined("Sidebar"))
            {
                <div class="col-lg-3 col-md-4">
                    @await RenderSectionAsync("Sidebar", required: false)
                </div>

                <main class="col-lg-9 col-md-8">
                    @RenderBody()
                </main>
            }
            else
            {
                <main class="col-lg-12">
                    @RenderBody()
                </main>
            }
        </div>
    </div>
    <partial name="_P_Footer" />

    <a href="#" class="btn btn-primary back-to-top"><i class="fa fa-angle-double-up"></i></a>

    <partial name="_P_Script" />

    <script src="~/js/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
