@model IEnumerable<DemoShop_QuaMonMot.Models.HangHoa>

<div class="container-fluid pt-5">
    <div class="row px-xl-5">
        <div class="col-lg-12 table-responsive mb-5">
            <h2 class="section-title position-relative text-uppercase mb-4"><span class="bg-secondary pr-3">My Wishlist</span></h2>
            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Products</th>
                        <th>Price</th>
                        <th>Stock Status</th>
                        <th>Add To Cart</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle text-left">
                                <img src="~/Hinh/HangHoa/@item.Hinh" alt="" style="width: 50px; margin-right: 15px;">
                                <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.MaHh" class="text-dark">@item.TenHh</a>
                            </td>
                            <td class="align-middle">$@item.DonGia</td>
                            <td class="align-middle text-success">In Stock</td>
                            <td class="align-middle">
                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@item.MaHh" class="btn btn-primary btn-sm">
                                    <i class="fa fa-shopping-cart"></i> Add to Cart
                                </a>
                            </td>
                            <td class="align-middle">
                                @* Dùng thẻ <a> thay vì button, dẫn trực tiếp về Action Remove *@
                                <a class="btn btn-sm btn-danger"
                                   asp-controller="YeuThich"
                                   asp-action="Remove"
                                   asp-route-id="@item.MaHh"
                                   onclick="return confirm('Bạn có muốn bỏ sản phẩm này khỏi danh sách yêu thích?');">
                                    <i class="fa fa-times"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <p>Your wishlist is empty!</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Go Shopping</a>
                </div>
            }
        </div>
    </div>
</div>