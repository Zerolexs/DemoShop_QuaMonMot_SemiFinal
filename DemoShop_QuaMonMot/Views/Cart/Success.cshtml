@{
    ViewData["Title"] = T["OrderSuccess"];
    var orderId = TempData["OrderId"];
    var orderTotal = TempData["OrderTotal"];
}

<div class="container-fluid py-5">
    <div class="container text-center">
        <div class="bg-light p-5">
            <div class="mb-4">
                <i class="fa fa-check-circle text-success" style="font-size: 72px;"></i>
            </div>

            <h2 class="text-uppercase mb-3">@T["OrderSuccess"]</h2>

            <p class="mb-4">
                @T["OrderSuccessMessage"]
            </p>

            @if (orderId != null)
            {
                <p class="mb-1"><strong>@T["OrderId"]</strong> #@orderId</p>
            }

            @if (orderTotal != null)
            {
                <p class="mb-4"><strong>@T["PaymentTotal"]</strong> $@orderTotal</p>
            }

            <div class="d-flex justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 mr-2">
                    @T["ContinueShopping"]
                </a>

                <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-primary px-4">
                    @T["ViewCart"]
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        alert("@T["OrderSuccessAlert"]");
    </script>
}
