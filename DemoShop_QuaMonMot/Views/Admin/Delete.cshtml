@model DemoShop_QuaMonMot.Models.HangHoa
@{
    ViewData["Title"] = T["DeleteProductTitle"];
}

<div class="container-fluid">
    <h2 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">@T["DeleteWarning"]</span></h2>
    <div class="row px-xl-5 justify-content-center">
        <div class="col-lg-6 bg-light p-30 text-center">
            <h4 class="text-danger">@T["PermanentDeleteConfirm"]</h4>
            <div class="my-4">
                <img src="~/Hinh/HangHoa/@Model.Hinh" style="width:200px;" class="img-thumbnail" />
                <h3 class="mt-2">@Model.TenHh</h3>
                <p>@T["ProductId"] @Model.MaHh</p>
                <p>@T["Price"]: $@Model.DonGia</p>
            </div>

            <form asp-action="DeleteConfirmed">
                @* Action thực thi xóa trong Controller *@
                <input type="hidden" asp-for="MaHh" />
                <button type="submit" class="btn btn-danger py-2 px-4 font-weight-bold">@T["ConfirmDeleteUpper"]</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary py-2 px-4">@T["CancelUpper"]</a>
            </form>
        </div>
    </div>
</div>
