@model DemoShop_QuaMonMot.DTOs.DangKy

@{
    ViewData["title"] = T["RegisterTitle"];
}

<div class="container-fluid">
    <form asp-action="DangKy" method="post" enctype="multipart/form-data">
        <div class="row px-xl-5">
            <div class="col-lg-8">
                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">@T["RegistrationInfo"]</span>
                </h5>
                <div class="bg-light p-30 mb-5">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="MaKh">@T["Username"]</label> <span class="text-danger">*</span>
                            <input asp-for="MaKh" class="form-control" placeholder="@T["Username"]" />
                            <span asp-validation-for="MaKh" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="MatKhau">@T["Password"]</label> <span class="text-danger">*</span>
                            <input asp-for="MatKhau" class="form-control" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="HoTen">@T["FullName"]</label> <span class="text-danger">*</span>
                            <input asp-for="HoTen" class="form-control" placeholder="@T["FullNamePlaceholder"]" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="GioiTinh">@T["Gender"]</label>
                            <div class="d-flex mt-2">
                                <div class="custom-control custom-radio mr-3">
                                    <input type="radio" class="custom-control-input" id="gt-nam" name="GioiTinh" value="true" checked>
                            <label class="custom-control-label" for="gt-nam">@T["Male"]</label>
                                </div>
                                <div class="custom-control custom-radio">
                                    <input type="radio" class="custom-control-input" id="gt-nu" name="GioiTinh" value="false">
                                    <label class="custom-control-label" for="gt-nu">@T["Female"]</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="NgaySinh">@T["BirthDate"]</label>
                            <input asp-for="NgaySinh" class="form-control" />
                            <span asp-validation-for="NgaySinh" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="DienThoai">@T["Phone"]</label> <span class="text-danger">*</span>
                            <input asp-for="DienThoai" class="form-control" placeholder="09xxxxxxx" />
                            <span asp-validation-for="DienThoai" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="Email">@T["Email"]</label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="DiaChi">@T["Address"]</label> <span class="text-danger">*</span>
                            <input asp-for="DiaChi" class="form-control" placeholder="@T["AddressPlaceholder"]" />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 form-group">
                            <label>@T["Avatar"]</label>
                            <input type="file" name="fHinh" class="form-control-file" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">@T["Confirm"]</span></h5>
                <div class="bg-light p-30 mb-5">
                    <div class="border-bottom">
                        <h6 class="mb-3">@T["MemberBenefits"]</h6>
                        <div class="d-flex justify-content-between">
                            <p>@T["RewardPoints"]</p>
                            <i class="fa fa-check text-success"></i>
                        </div>
                        <div class="d-flex justify-content-between">
                            <p>@T["BirthdayOffer"]</p>
                            <i class="fa fa-check text-success"></i>
                        </div>
                    </div>
                    <div class="pt-2">
                        <p class="small text-muted">@T["RegisterAgreement"]</p>
                        <button type="submit" class="btn btn-block btn-primary font-weight-bold py-3">@T["RegisterNow"]</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</div>
