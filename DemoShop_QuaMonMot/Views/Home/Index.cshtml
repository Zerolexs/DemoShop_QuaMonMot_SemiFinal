@using Microsoft.AspNetCore.Http
@model IEnumerable<DemoShop_QuaMonMot.Models.HangHoa>
@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPage = ViewBag.TotalPage ?? 1;
    ViewData["Title"] = "Trang chủ - Danh sách sản phẩm";
}

@section Sidebar {
    <partial name="_P_Sidebar" />
}

<div class="row pb-3">
    @* --- THANH CÔNG CỤ --- *@
    <div class="col-12 pb-1">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <button class="btn btn-sm btn-light"><i class="fa fa-th-large"></i></button>
                <button class="btn btn-sm btn-light ml-2"><i class="fa fa-bars"></i></button>
            </div>
            <div class="ml-2">
                <div class="btn-group">
                    <button type="button" class="btn btn-sm btn-light dropdown-toggle" data-toggle="dropdown">Sắp xếp</button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="#">Mới nhất</a>
                        <a class="dropdown-item" href="#">Phổ biến nhất</a>
                        <a class="dropdown-item" href="#">Đánh giá cao</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- NÚT ADMIN --- *@
    @if (Context.Session.GetInt32("VaiTro") == 1)
    {
        <div class="col-12 mb-4">
            <a asp-controller="Admin" asp-action="Create" class="btn btn-primary font-weight-bold py-2 px-4">
                <i class="fa fa-plus mr-2"></i> Thêm sản phẩm mới
            </a>
        </div>
    }

    @* --- DANH SÁCH SẢN PHẨM --- *@
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6 col-sm-6 pb-1">
            <div class="product-item bg-light mb-4">
                <div class="product-img position-relative overflow-hidden">
                    @* SỬA: Thêm onerror để xử lý ảnh lỗi *@
                    <img class="img-fluid w-100" src="~/Hinh/HangHoa/@item.Hinh" alt="@item.TenHh"
                         onerror="this.src='/Hinh/HangHoa/default.jpg';">

                    <div class="product-action">
                        <a class="btn btn-outline-dark btn-square" asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.MaHh">
                            <i class="fa fa-shopping-cart"></i>
                        </a>
                        <a class="btn btn-outline-dark btn-square" href="#"><i class="far fa-heart"></i></a>
                        <a class="btn btn-outline-dark btn-square" href="#"><i class="fa fa-sync-alt"></i></a>
                        <a class="btn btn-outline-dark btn-square" asp-controller="Home" asp-action="Detail" asp-route-id="@item.MaHh">
                            <i class="fa fa-search"></i>
                        </a>
                    </div>
                </div>
                <div class="text-center py-4 px-2">
                    <a class="h6 text-decoration-none text-truncate d-block" asp-controller="Home" asp-action="Detail" asp-route-id="@item.MaHh">@item.TenHh</a>
                    <div class="d-flex align-items-center justify-content-center mt-2">
                        @* Dùng ?? 0 để tránh lỗi nếu DonGia bị Null, sau đó mới ToString *@
                        <h5>$@((item.DonGia ?? 0).ToString("F2"))</h5>

                        <h6 class="text-muted ml-2">
                            @* Tính giá khuyến mãi và làm tròn 2 chữ số *@
                            <del>$@(((item.DonGia ?? 0) * 1.1).ToString("F2"))</del>
                        </h6>
                    </div>

                    <div class="d-flex align-items-center justify-content-center mb-1">
                        <small class="fa fa-eye text-primary mr-2"></small>
                        <small>@item.SoLanXem lượt xem</small>
                    </div>

                    @if (Context.Session.GetInt32("VaiTro") == 1)
                    {
                        <div class="d-flex align-items-center justify-content-center mt-3 pt-2 border-top">
                            <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.MaHh" class="btn btn-sm btn-warning mr-2">
                                <i class="fa fa-edit"></i> Sửa
                            </a>
                            <form asp-controller="Admin" asp-action="DeleteHangHoa" asp-route-id="@item.MaHh"
                                  method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không?');">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fa fa-trash"></i> Xóa
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* --- PHÂN TRANG --- *@
    <div class="col-12">
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@Context.Request.Query["search"]">Trước</a>
                </li>
                @for (int i = 1; i <= totalPage; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" asp-controller="Home" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Context.Request.Query["search"]">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPage ? "disabled" : "")">
                    <a class="page-link" asp-controller="Home" asp-action="Index"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@Context.Request.Query["search"]">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>