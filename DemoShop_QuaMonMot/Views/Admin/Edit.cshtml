@model DemoShop_QuaMonMot.Models.HangHoa
@{
    ViewData["Title"] = T["EditProductTitle"];
}

<div class="container-fluid">
    <h2 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">@T["EditProductPrefix"] @Model.TenHh</span></h2>
    <div class="row px-xl-5">
        <div class="col-lg-8 bg-light p-30">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @* CỰC KỲ QUAN TRỌNG: Phải có ID ẩn để Controller tìm đúng sản phẩm *@
                <input type="hidden" name="MaHh" value="@Model.MaHh" />

                <div class="form-group">
                    <label>@T["ProductName"]</label>
                    <input name="TenHh" value="@Model.TenHh" class="form-control" />
                </div>

                <div class="form-group">
                    <label>@T["UnitPrice"]</label>
                    <input name="DonGia" value="@Model.DonGia" type="number" class="form-control" />
                </div>

                <div class="form-group">
                    <label>@T["DiscountPercent"]</label>
                    <input name="GiamGia" value="@Model.GiamGia" type="number" class="form-control" />
                </div>

                <div class="form-group">
                    <label>@T["ProductType"]</label>
                    <select name="MaLoai" class="form-control" asp-items="ViewBag.MaLoai"></select>
                </div>
                <div class="form-group">
                    <label>@T["ProductionDate"]</label>
                    <input type="date" name="NgaySx" value="@Model.NgaySx.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="form-group">
                    <label>@T["Description"]</label>
                    <textarea name="MoTa" class="form-control">@Model.MoTa</textarea>
                </div>

                <div class="form-group">
                    <label>@T["NewImageOptional"]</label>
                    <input type="file" name="fHinh" class="form-control-file" />
                </div>

                <button type="submit" class="btn btn-primary">@T["SaveChanges"]</button>
            </form>
        </div>
    </div>
</div>
