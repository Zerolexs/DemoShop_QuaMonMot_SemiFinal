@model DemoShop_QuaMonMot.Models.ProfileVM

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

@* Hiển thị thông báo từ TempData *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle mr-2"></i> @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="row">
    <!-- Cột trái: Cập nhật thông tin cá nhân -->
    <div class="col-md-7">
        <div class="bg-light p-30 mb-5">
            <h6 class="mb-4 text-uppercase font-weight-bold border-bottom pb-2">Thông tin cá nhân</h6>
            <form asp-action="UpdateProfile" method="post">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="MaKh">Tên đăng nhập</label>
                        <input class="form-control" value="@Model.MaKh" disabled />
                        <input type="hidden" asp-for="MaKh" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="Email">Email</label>
                        <input class="form-control" value="@Model.Email" disabled />
                        <input type="hidden" asp-for="Email" />
                    </div>
                    <div class="col-md-12 form-group">
                        <label asp-for="HoTen">Họ và tên</label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="d-block">Giới tính</label>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="gt-nam" name="GioiTinh" value="true" class="custom-control-input" @(Model.GioiTinh ? "checked" : "")>
                            <label class="custom-control-label" for="gt-nam">Nam</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="gt-nu" name="GioiTinh" value="false" class="custom-control-input" @(!Model.GioiTinh ? "checked" : "")>
                            <label class="custom-control-label" for="gt-nu">Nữ</label>
                        </div>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="NgaySinh">Ngày sinh</label>
                        <input asp-for="NgaySinh" class="form-control" type="date" />
                        <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12 form-group">
                        <label asp-for="DienThoai">Số điện thoại</label>
                        <input asp-for="DienThoai" class="form-control" placeholder="Ví dụ: 0912345678" />
                        <span asp-validation-for="DienThoai" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12 form-group">
                        <label asp-for="DiaChi">Địa chỉ</label>
                        <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Địa chỉ nhận hàng..."></textarea>
                    </div>
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn btn-primary font-weight-bold py-2 px-4">
                            <i class="fa fa-save mr-1"></i> Lưu thông tin
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Cột phải: Đổi mật khẩu -->
    <div class="col-md-5">
        <div class="bg-light p-30 mb-5">
            <h6 class="mb-4 text-uppercase font-weight-bold border-bottom pb-2">Đổi mật khẩu</h6>
            <form asp-action="ChangePassword" method="post">
                <div class="form-group">
                    <label asp-for="OldPassword">Mật khẩu hiện tại</label>
                    <input asp-for="OldPassword" class="form-control" type="password" placeholder="Nhập mật khẩu cũ" required />
                </div>
                <div class="form-group">
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="Tối thiểu 6 ký tự" required />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Nhập lại mật khẩu mới" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-danger font-weight-bold py-2 px-4 w-100 mt-2">
                    <i class="fa fa-key mr-1"></i> Cập nhật mật khẩu
                </button>
            </form>
        </div>
    </div>
</div>
</div>
</div>


@section Scripts {
    @* Thêm bộ kiểm tra dữ liệu phía Client (JavaScript) *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}