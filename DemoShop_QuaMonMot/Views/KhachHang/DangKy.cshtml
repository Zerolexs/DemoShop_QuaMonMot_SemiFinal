@model DemoShop_QuaMonMot.DTOs.DangKy

@{
    ViewData["title"] = "Đăng Ký Tài Khoản";
}

<div class="container-fluid">
    <form asp-action="DangKy" method="post" enctype="multipart/form-data">
        <div class="row px-xl-5">
            <div class="col-lg-8">
                <h5 class="section-title position-relative text-uppercase mb-3">
                    <span class="bg-secondary pr-3">Thông tin đăng ký</span>
                </h5>
                <div class="bg-light p-30 mb-5">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="MaKh"></label> <span class="text-danger">*</span>
                            <input asp-for="MaKh" class="form-control" placeholder="Tên đăng nhập..." />
                            <span asp-validation-for="MaKh" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="MatKhau"></label> <span class="text-danger">*</span>
                            <input asp-for="MatKhau" class="form-control" />
                            <span asp-validation-for="MatKhau" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="HoTen"></label> <span class="text-danger">*</span>
                            <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="GioiTinh"></label>
                            <div class="d-flex mt-2">
                                <div class="custom-control custom-radio mr-3">
                                    <input type="radio" class="custom-control-input" id="gt-nam" name="GioiTinh" value="true" checked>
                                    <label class="custom-control-label" for="gt-nam">Nam</label>
                                </div>
                                <div class="custom-control custom-radio">
                                    <input type="radio" class="custom-control-input" id="gt-nu" name="GioiTinh" value="false">
                                    <label class="custom-control-label" for="gt-nu">Nữ</label>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="NgaySinh"></label>
                            <input asp-for="NgaySinh" class="form-control" />
                            <span asp-validation-for="NgaySinh" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="DienThoai"></label> <span class="text-danger">*</span>
                            <input asp-for="DienThoai" class="form-control" placeholder="09xxxxxxx" />
                            <span asp-validation-for="DienThoai" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="Email"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" placeholder="example@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label asp-for="DiaChi"></label> <span class="text-danger">*</span>
                            <input asp-for="DiaChi" class="form-control" placeholder="Số nhà, tên đường..." />
                            <span asp-validation-for="DiaChi" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 form-group">
                            <label>Ảnh đại diện</label>
                            <input type="file" name="fHinh" class="form-control-file" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Xác nhận</span></h5>
                <div class="bg-light p-30 mb-5">
                    <div class="border-bottom">
                        <h6 class="mb-3">Quyền lợi thành viên</h6>
                        <div class="d-flex justify-content-between">
                            <p>Tích lũy điểm thưởng</p>
                            <i class="fa fa-check text-success"></i>
                        </div>
                        <div class="d-flex justify-content-between">
                            <p>Ưu đãi ngày sinh nhật</p>
                            <i class="fa fa-check text-success"></i>
                        </div>
                    </div>
                    <div class="pt-2">
                        <p class="small text-muted">Bằng cách nhấn Đăng ký, bạn đồng ý với các điều khoản của shop.</p>
                        <button type="submit" class="btn btn-block btn-primary font-weight-bold py-3">Đăng Ký Ngay</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</div>