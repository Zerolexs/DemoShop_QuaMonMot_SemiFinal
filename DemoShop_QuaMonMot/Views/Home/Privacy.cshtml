@{
    ViewData["Title"] = T["PrivacyTeamTitle"];
}

<div class="container-fluid pt-5">
    <div class="container">
        <div class="section-title position-relative text-center mx-auto mb-5 pb-3" style="max-width: 600px;">
            <h2 class="text-primary font-weight-bold">@T["PrivacyPolicy"]</h2>
            <hr class="w-25 mx-auto">
        </div>
        <div class="row px-xl-5">
            <div class="col-lg-12 mb-5">
                <div class="bg-light p-4 rounded shadow-sm">
                    <p class="lead">@T["PrivacyIntro"]</p>
                    <ul class="list-unstyled">
                        <li class="mb-3"><i class="fa fa-shield-alt text-primary mr-3"></i><strong>@T["DataSafetyTitle"]</strong> @T["DataSafetyText"]</li>
                        <li class="mb-3"><i class="fa fa-user-lock text-primary mr-3"></i><strong>@T["PrivacyTitle"]</strong> @T["PrivacyText"]</li>
                        <li class="mb-3"><i class="fa fa-database text-primary mr-3"></i><strong>@T["TransparencyTitle"]</strong> @T["TransparencyText"]</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="section-title position-relative text-center mx-auto mb-5 pb-3" style="max-width: 600px;">
            <h2 class="text-primary font-weight-bold">@T["DevelopmentTeam"]</h2>
            <hr class="w-25 mx-auto">
        </div>

        <div class="row px-xl-5">
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="team-item bg-light text-center p-4 shadow-sm rounded">
                    <div class="position-relative overflow-hidden mb-4" style="border-radius: 50%; width: 180px; height: 180px; margin: 0 auto; border: 5px solid #fff;">
                        <img class="img-fluid w-100 h-100" src="~/Hinh/Team/member1.jpg" alt="Lưu Tiến Bảo"
                             style="object-fit: cover;" onerror="this.src='/Hinh/HangHoa/default.jpg';">
                    </div>
                    <h5 class="font-weight-bold">Lưu Tiến Bảo</h5>
                    <p class="text-primary text-uppercase small mb-2">@T["StudentId"] 1923040479</p>
                    <p class="px-2 text-muted">@T["TeamBioBao"]</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="team-item bg-light text-center p-4 shadow-sm rounded">
                    <div class="position-relative overflow-hidden mb-4" style="border-radius: 50%; width: 180px; height: 180px; margin: 0 auto; border: 5px solid #fff;">
                        <img class="img-fluid w-100 h-100" src="~/Hinh/Team/member3.jpg" alt="Member 3"
                             style="object-fit: cover;" onerror="this.src='/Hinh/HangHoa/default.jpg';">
                    </div>
                    <h5 class="font-weight-bold">Phan Quốc Thắng</h5>
                    <p class="text-primary text-uppercase small mb-2">@T["StudentId"] xxxxxxxxx</p>
                    <p class="px-2 text-muted">@T["TeamBioThang"]</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 mb-4">
                <div class="team-item bg-light text-center p-4 shadow-sm rounded">
                    <div class="position-relative overflow-hidden mb-4" style="border-radius: 50%; width: 180px; height: 180px; margin: 0 auto; border: 5px solid #fff;">
                        <img class="img-fluid w-100 h-100" src="~/Hinh/Team/member2.jpg" alt="Member 2"
                             style="object-fit: cover;" onerror="this.src='/Hinh/HangHoa/default.jpg';">
                    </div>
                    <h5 class="font-weight-bold">Nguyễn Thành Long</h5>
                    <p class="text-primary text-uppercase small mb-2">@T["StudentId"] xxxxxxxxx</p>
                    <p class="px-2 text-muted">@T["TeamBioLong"]</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .team-item {
        transition: .3s;
    }

        .team-item:hover {
            background: #ffffff !important;
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

        .team-item img {
            transition: .3s;
        }
</style>
