@model DemoShop_QuaMonMot.Models.ProfileVM

@{
    ViewData["Title"] = T["ProfileTitle"];
}

@* Hiển thị thông báo từ TempData *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa fa-check-circle mr-2"></i> @TempData["Message"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
}

<div class="row">
    <!-- Cột trái: Cập nhật thông tin cá nhân -->
    <div class="col-md-7">
        <div class="bg-light p-30 mb-5">
            <h6 class="mb-4 text-uppercase font-weight-bold border-bottom pb-2">@T["PersonalInfo"]</h6>
            <form asp-action="UpdateProfile" method="post">
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label asp-for="MaKh">@T["Username"]</label>
                        <input class="form-control" value="@Model.MaKh" disabled />
                        <input type="hidden" asp-for="MaKh" />
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="Email">@T["Email"]</label>
                        <input class="form-control" value="@Model.Email" disabled />
                        <input type="hidden" asp-for="Email" />
                    </div>
                    <div class="col-md-12 form-group">
                        <label asp-for="HoTen">@T["FullName"]</label>
                        <input asp-for="HoTen" class="form-control" placeholder="@T["FullName"]" />
                        <span asp-validation-for="HoTen" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 form-group">
                        <label class="d-block">@T["Gender"]</label>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="gt-nam" name="GioiTinh" value="true" class="custom-control-input" @(Model.GioiTinh ? "checked" : "")>
                            <label class="custom-control-label" for="gt-nam">@T["Male"]</label>
                        </div>
                        <div class="custom-control custom-radio custom-control-inline">
                            <input type="radio" id="gt-nu" name="GioiTinh" value="false" class="custom-control-input" @(!Model.GioiTinh ? "checked" : "")>
                            <label class="custom-control-label" for="gt-nu">@T["Female"]</label>
                        </div>
                    </div>
                    <div class="col-md-6 form-group">
                        <label asp-for="NgaySinh">@T["BirthDate"]</label>
                        <input asp-for="NgaySinh" class="form-control" type="date" />
                        <span asp-validation-for="NgaySinh" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12 form-group">
                        <label asp-for="DienThoai">@T["Phone"]</label>
                        <input asp-for="DienThoai" class="form-control" placeholder="0912345678" />
                        <span asp-validation-for="DienThoai" class="text-danger small"></span>
                    </div>
                    <div class="col-md-12 form-group">
                        <label asp-for="DiaChi">@T["Address"]</label>
                        <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="@T["Address"]"></textarea>
                    </div>
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn btn-primary font-weight-bold py-2 px-4">
                            <i class="fa fa-save mr-1"></i> @T["SaveInfo"]
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Cột phải: Đổi mật khẩu -->
    <div class="col-md-5">
        <div class="bg-light p-30 mb-5">
            <h6 class="mb-4 text-uppercase font-weight-bold border-bottom pb-2">@T["ChangePassword"]</h6>
            <form asp-action="ChangePassword" method="post">
                <div class="form-group">
                    <label asp-for="OldPassword">@T["CurrentPassword"]</label>
                    <input asp-for="OldPassword" class="form-control" type="password" placeholder="@T["CurrentPassword"]" required />
                </div>
                <div class="form-group">
                    <label asp-for="NewPassword">@T["NewPassword"]</label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="@T["NewPassword"]" required />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword">@T["ConfirmNewPassword"]</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="@T["ConfirmNewPassword"]" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-danger font-weight-bold py-2 px-4 w-100 mt-2">
                    <i class="fa fa-key mr-1"></i> @T["UpdatePassword"]
                </button>
            </form>
        </div>
    </div>
</div>
</div>
</div>


@section Scripts {
    @* Thêm bộ kiểm tra dữ liệu phía Client (JavaScript) *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
