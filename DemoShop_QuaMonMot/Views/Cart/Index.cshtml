@model IEnumerable<DemoShop_QuaMonMot.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng";
}
<!-- Cart Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-8 table-responsive mb-5">
            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>Products</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Remove</th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @foreach(var item in Model)
                    {
                        <tr>
                            <td class="align-middle"><img src="~/Hinh/HangHoa/@item.Hinh" alt="@item.tenHH" style="width: 50px;"><a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.MaHh">@item.tenHH</a></td>
                            <td class="align-middle">$@item.DonGia</td>
                            <td class="align-middle">
                                <div class="input-group quantity mx-auto" style="width: 100px;">
                                    <div class="input-group-btn">
                                        @* Nút TRỪ: truyền amount = -1 *@
                                        <a asp-action="UpdateQuantity" asp-controller="Cart"
                                           asp-route-id="@item.MaHh" asp-route-amount="-1"
                                           class="btn btn-sm btn-primary">
                                            <i class="fa fa-minus"></i>
                                        </a>
                                    </div>

                                    <input type="text" class="form-control form-control-sm bg-secondary border-0 text-center" value="@item.Soluong" readonly>

                                    <div class="input-group-btn">
                                        @* Nút CỘNG: truyền amount = 1 *@
                                        <a asp-action="UpdateQuantity" asp-controller="Cart"
                                           asp-route-id="@item.MaHh" asp-route-amount="1"
                                           class="btn btn-sm btn-primary">
                                            <i class="fa fa-plus"></i>
                                        </a>
                                    </div>
                                </div>
                            </td>
                            <td class="align-middle">$@item.ThanhTien</td>
                            <td class="align-middle">
                                <a asp-action="RemoveCart" asp-controller="Cart" asp-route-id="@item.MaHh">
                                    <button class="btn btn-sm btn-danger">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-lg-4">
            <form class="mb-30" action="">
                <div class="input-group">
                    <input type="text" class="form-control border-0 p-4" placeholder="Coupon Code">
                    <div class="input-group-append">
                        <button class="btn btn-primary">Apply Coupon</button>
                    </div>
                </div>
            </form>
            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Cart Summary</span></h5>
            <div class="bg-light p-30 mb-5">
                <div class="border-bottom pb-2">
                    <div class="d-flex justify-content-between mb-3">
                        <h6>Subtotal</h6>
                        <h6>$@Model.Sum(s =>s.ThanhTien)</h6>
                    </div>
                    <div class="d-flex justify-content-between">
                        <h6 class="font-weight-medium">Shipping</h6>
                        <h6 class="font-weight-medium">$10</h6>
                    </div>
                </div>
                <div class="pt-2">
                    <div class="d-flex justify-content-between mt-2">
                        <h5>Total</h5>
                        <h5>$@Model.Sum(s => s.ThanhTien)</h5>
                    </div>
                    <button class="btn btn-block btn-primary font-weight-bold my-3 py-3">Proceed To Checkout</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Cart End -->
