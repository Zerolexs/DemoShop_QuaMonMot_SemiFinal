@model ErrorViewModel
@{
    ViewData["Title"] = T["ErrorTitle"];
}

<h1 class="text-danger">@T["ErrorTitle"]</h1>
<h2 class="text-danger">@T["ErrorMessage"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@T["RequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@T["DevelopmentMode"]</h3>
<p>
    @T["DevelopmentModeInfo"]
</p>
<p>
    <strong>@T["DevelopmentModeWarning"]</strong>
    @T["LocalDebugInfo"]
</p>
